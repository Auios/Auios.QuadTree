{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Auios.QuadTree.sln",
        "-c",
        "Debug"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "command": "dotnet",
      "type": "process",
      "args": [
        "test",
        "${workspaceFolder}/Auios.QuadTree.sln",
        "-c",
        "Release"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "pack",
      "command": "dotnet",
      "type": "process",
      "args": [
        "pack",
        "${workspaceFolder}/Auios.QuadTree/Auios.QuadTree.csproj",
        "-c",
        "Release",
        "-o",
        "${workspaceFolder}/artifacts"
      ],
      "dependsOn": "test",
      "problemMatcher": "$msCompile"
    }
  ]
}
