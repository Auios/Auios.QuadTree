<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyName>Auios.QuadTree</AssemblyName>
    <RootNamespace>Auios.QuadTree</RootNamespace>
    <Authors>Auios</Authors>
    <PackageId>Auios.QuadTree</PackageId>
    <PackageTags>QuadTree;Data;Structure;Spatial;2D;Quad;Tree;Search;Searching</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Auios/Auios.QuadTree</PackageProjectUrl>
    <PackageIcon>Logo.png</PackageIcon>
    <RepositoryUrl>https://github.com/Auios/Auios.QuadTree</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Description>Generic QuadTree algorithm inspired by Leonidovia's Ultimate QuadTree.</Description>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <Product>Auios.QuadTree</Product>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>2.0.0
      * Target .NET 10
      * Removed Auios.Rectangle dependency (QuadTreeRect is now self-contained)
      * FindObjects returns objects whose bounds intersect the search region
      * Fixed FindObjects(T) using right/bottom as width/height
      * Objects that span child quadrants are retained on the parent node
      * Rewritten for speed: flat node storage, bounds cached at insert, no per-search tree walk, no hashing
      * QuadTreeRect is now a struct, so searches do not allocate
      * Added FindObjects overloads that fill a List&lt;T&gt;, Remove, NodeCount and GetGrid(List)
      * Count() is O(1); Clear() keeps storage so per-frame rebuilds do not allocate
      * Equal value-type objects are no longer collapsed into one (each Insert is stored)
      * Objects with NaN bounds are rejected; a negative maxObjects throws
    </PackageReleaseNotes>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\Media\Logo.png" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
